# Genera una clave aleatoria propia de al menos 32 caracteres.
SECRET_KEY=
# Clave Fernet propia. Conserva la existente si ya hay un despliegue.
TOKEN_ENCRYPTION_KEY=
PUBLIC_BASE_URL=https://trasladarnotas.eu.pythonanywhere.com
GOOGLE_CLIENT_SECRETS=oauth_credentials.json
# Permite cuentas Google Workspace verificadas de todo el personal de este dominio.
# El centro debe autorizar este alcance. Ya no se utiliza TEACHER_EMAILS.
TEACHER_DOMAIN=cuatrovientos.org
# Obligatorio: indica el dominio REAL del alumnado; varios separados por comas.
STUDENT_DOMAINS=
COOKIE_SECURE=true
# Opcional: ruta absoluta fuera de cualquier directorio público
# DATABASE=/home/TU_CUENTA/trasladar-notas/instance/private.sqlite3
# Completar con textos validados por el centro. Aparecen públicamente en /privacidad.
# Responsable: identidad jurídica real del centro responsable del tratamiento.
PRIVACY_CONTROLLER=
# Canal institucional para derechos, consultas y contacto del DPD.
PRIVACY_CONTACT=
# Base jurídica aplicable a la entrega de evaluaciones, validada por el centro.
PRIVACY_LEGAL_BASIS=
# Plazo documental configurable: completar según decisión del centro. No activa borrado de Drive.
PRIVACY_RETENTION=
# Proveedores realmente usados, ubicación y garantías (PythonAnywhere y Google).
PRIVACY_PROVIDERS=
